.pyright/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db

# Logs
*.log

# Local datasets and run outputs (gated benchmark data is never committed)
/data/
/results/
/wandb
/exports/
